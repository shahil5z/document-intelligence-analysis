# Copy to .env.local for `npm run dev`.
# Public URL of the FastAPI backend, no trailing slash. It is inlined into the browser
# bundle at build time (NEXT_PUBLIC_*), so it must never hold a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: canonical site URL for Open Graph / social previews (defaults to the Vercel
# production URL, or http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# Optional, server-only (never NEXT_PUBLIC_): lets the BFF pass the browser IP to the API
# for per-IP rate limits (register, login, demo). Must equal CLIENT_IP_HEADER_SECRET in
# the API's env. Empty = not sent; all browser traffic then counts as this server's IP.
DIP_CLIENT_IP_SECRET=

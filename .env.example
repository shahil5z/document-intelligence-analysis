# Copy to .env (or run: python scripts/generate_env.py). Never commit .env.
# Read by app/core/config.py (pydantic-settings) and by docker compose.
# Placeholder values starting with "replace-with" are rejected at startup.

APP_NAME=Document Intelligence Platform
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000

# Required. At least 32 characters, URL-safe.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL. DATABASE_URL is built from these parts unless DATABASE_URL is set.
# Inside docker compose, POSTGRES_HOST/PORT are set to the postgres service automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dip
POSTGRES_USER=dip
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
# DATABASE_URL=

# Redis (Celery broker + readiness check). REDIS_URL / CELERY_BROKER_URL /
# CELERY_RESULT_BACKEND are built from these parts unless set explicitly.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-a-random-redis-password
# REDIS_URL=
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Uploads and storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage_data
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=pdf,docx,txt
ALLOWED_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Comma-separated explicit origins; "*" is rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Used only by POST /ask (LLM_PROVIDER=openai). Upload, processing and /search work
# without it; /ask then returns 503 when evidence exists. Never commit a real key.
OPENAI_API_KEY=replace-with-your-openai-api-key

# --- Document processing (worker) -------------------------------------------------
# Local sentence-transformers model, downloaded on first use (HF_HOME in compose).
# EMBEDDING_DIMENSION must match the vector(384) column of migration 0002.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
# PyTorch threads per API/worker process (0 = one per CPU core). 2 avoids CPU
# oversubscription when the API and worker processes share one machine.
TORCH_NUM_THREADS=2
# Chunk size and overlap in tokens of the embedding model's tokenizer (max 512 for bge-small).
CHUNK_SIZE=400
CHUNK_OVERLAP=60
MAX_CHUNKS_PER_DOCUMENT=1000
# 1 = never contact Hugging Face (model must already be in the HF_HOME cache volume).
HF_HUB_OFFLINE=0

# --- Retrieval (/search, /ask) --------------------------------------------------------
TOP_K=5
MAX_TOP_K=20
CANDIDATE_K=40
MAX_QUERY_LENGTH=1000
# Minimum cosine similarity for a chunk to count as evidence in /ask (see docs/rag.md).
MIN_EVIDENCE_SIMILARITY=0.48
RERANKING_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=20

# --- Question answering (/ask) ----------------------------------------------------------
# openai = any OpenAI-compatible /chat/completions endpoint; none = /ask disabled (503).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=700
LLM_TEMPERATURE=0
MAX_CONTEXT_TOKENS=3000

# --- Hardening, rate limiting, observability (DIP3) -------------------------------------
# API docs (/docs, /redoc, /openapi.json): empty = on, except when APP_ENV=production.
API_DOCS_ENABLED=
# Limit for non-upload request bodies; uploads get MAX_UPLOAD_SIZE_BYTES + overhead.
MAX_REQUEST_BODY_BYTES=1048576
UPLOAD_BODY_OVERHEAD_BYTES=65536
SECURITY_HEADERS_ENABLED=true
# Fixed-window limits "<count>/<second|minute|hour|day>". redis = shared across
# processes (required in production); memory = per process (development only).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_LOGIN_PER_EMAIL=5/minute
RATE_LIMIT_UPLOAD=30/minute
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_ASK=20/minute
RATE_LIMIT_REPROCESS=10/minute
# Prometheus text format on GET /metrics (scrape from the internal network only).
METRICS_ENABLED=true
# Worker exporter port inside the worker container (compose sets it; empty = off).
WORKER_METRICS_PORT=
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300
# A job still "processing"/"retrying" after this many seconds is failed by the stale-job
# reconciler (worker beat; must exceed CELERY_TASK_TIME_LIMIT). 0 interval = not scheduled.
STALE_JOB_TIMEOUT_SECONDS=900
STALE_JOB_CHECK_INTERVAL_SECONDS=300

# Test suite only: a disposable database whose name contains "test", and optionally
# an authenticated Redis URL (redis://:<password>@localhost:6379/0) for one readiness test.
# TEST_DATABASE_URL=
# TEST_REDIS_URL=

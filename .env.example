# Copy to .env and adjust. Never commit .env.
# All values are read by app/core/config.py (pydantic-settings).

ENVIRONMENT=development
LOG_LEVEL=INFO

# Required. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Used by docker compose to build the in-network URLs.
POSTGRES_USER=dip
POSTGRES_PASSWORD=dip
POSTGRES_DB=dip
API_PORT=8000

# Used when running the API / worker directly on the host (outside compose).
DATABASE_URL=postgresql+psycopg://dip:dip@localhost:5432/dip
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Uploads
MAX_UPLOAD_SIZE_BYTES=10485760
STORAGE_PATH=./storage_data
ALLOWED_EXTENSIONS=pdf,docx,txt
ALLOWED_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Comma-separated explicit origins; "*" is rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Test suite only: a disposable database whose name contains "test".
TEST_DATABASE_URL=postgresql+psycopg://dip:dip@localhost:5432/dip_test

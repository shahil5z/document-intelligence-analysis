# Environment / secrets (every .env variant; only the documented templates are tracked)
.env
.env*
!.env.example
!.env.production.example
!frontend/.env.example
# A bare file literally named "env" at the repository root (used for keeping keys locally)
/env
*.pem
*.key

# Git bundles and archives
*.bundle
*.zip
*.tar.gz

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Tooling caches and coverage reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/

# Local runtime data: uploads and document storage. Anchored to the repository root so
# that source packages such as app/storage/ are NOT ignored.
/storage/
/storage_data/
/uploads/
/logs/
*.log

# Brand source artwork (the derived assets in frontend/public/brand/ are tracked)
logo-source*
*-source.png
*.psd
*.afdesign
*.ai

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local production-like E2E artefacts (local CA certificate, logs)
/.e2e/

# Frontend
node_modules/
.next/
/frontend/out/
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/e2e-screenshots/
/frontend/next-env.d.ts
.vercel/
*.tsbuildinfo

# Keys, credentials and local databases
id_rsa*
id_ed25519*
*.ppk
*credentials*.json
*.db
*.sqlite
*.sqlite3
*.dump

# Model caches and docker volume data
.cache/
hf_cache/
/models_cache/
/docker-data/
/volumes/

# Logo dropped at the repo root (brand assets live in frontend/public/brand/)
/logo.png
/micro.tmp

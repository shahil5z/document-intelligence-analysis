# Production settings for docker-compose.prod.yml. Copy to .env.production on the server
# (chmod 600, owned by the deploy user), replace every <...> value, never commit it.
#   cp .env.production.example .env.production && chmod 600 .env.production
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
LOG_LEVEL=INFO

# --- Public hostname and TLS (Caddy) -------------------------------------------------
# A DNS name pointing at the VM's public IP. Without a domain use a free name such as
# <dashed-public-ip>.sslip.io (e.g. 203-0-113-7.sslip.io) or a DuckDNS subdomain.
API_DOMAIN=<api.example.com>
# E-mail for Let's Encrypt expiry notices (or "internal" for a local test CA only).
CADDY_TLS=<you@example.com>

# --- Frontend origin(s) allowed by CORS (comma-separated, https:// only) -----------------
CORS_ALLOWED_ORIGINS=<https://your-app.vercel.app>

# --- Secrets (required) -------------------------------------------------------------------
JWT_SECRET_KEY=<at-least-32-random-characters>
POSTGRES_PASSWORD=<random-password>
REDIS_PASSWORD=<random-password>

# --- Question answering ---------------------------------------------------------------
# Only POST /ask uses it. Leave empty and /ask answers 503 "not configured" while
# upload, processing and search keep working.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- File storage -------------------------------------------------------------------
# local = Docker volume on the VM's boot/block volume (default).
# oci   = OCI Object Storage through its S3 compatibility API.
STORAGE_BACKEND=local
STORAGE_S3_BUCKET=
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
STORAGE_S3_ENDPOINT_URL=
# The OCI region identifier, e.g. eu-frankfurt-1
STORAGE_S3_REGION=
# An OCI "Customer Secret Key" (Profile > Customer secret keys): access key + secret.
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PREFIX=

# --- Capacity (2 OCPU / 12 GB defaults) -------------------------------------------------
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2
TORCH_NUM_THREADS=1

# --- Public demo rate limits (<count>/<second|minute|hour|day>) --------------------------
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_UPLOAD=30/day
RATE_LIMIT_ASK=20/hour
RATE_LIMIT_REPROCESS=20/day

# --- Backups (scripts/backup_postgres.sh) ---------------------------------------------
BACKUP_DIR=/var/backups/dip
BACKUP_RETENTION_DAYS=14
# Optional: encrypt dumps to this GPG recipient (public key imported on the server).
BACKUP_GPG_RECIPIENT=
# Optional: also copy dumps to this bucket (uses the STORAGE_S3_* endpoint and keys).
BACKUP_S3_BUCKET=
